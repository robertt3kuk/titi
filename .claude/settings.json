{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin master)",
      "Bash(git rebase origin/master)",
      "Bash(git rebase --abort)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(cargo fmt --all --check)",
      "Bash(cargo run -p titi-cli:*)",
      "Bash(cargo run -p titi-genome --example map:*)",
      "Bash(titi-map:*)",
      "Bash(bash scripts/check-research.sh)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin +:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.titi/agent/auth*)"
    ]
  }
}
